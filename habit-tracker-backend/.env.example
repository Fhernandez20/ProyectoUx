# Copia este archivo como ".env" y ajusta los valores. El archivo ".env" NO se sube a GitHub.

# Conexión a MongoDB. Estos valores corresponden al contenedor de Docker Desktop
# del curso (usuario admin, contraseña 123456, base de datos nestdb).
DATABASE_URL="mongodb://admin:123456@localhost:27017/nestdb?authSource=admin"

# Clave con la que se firman los tokens de sesión (JWT). Usa una cadena larga y
# aleatoria, distinta en cada entorno. Nunca la compartas.
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Puerto del backend (opcional, por defecto 3000)
PORT=3000

# Origen permitido por CORS (opcional). Si se define, solo ese origen puede llamar
# a la API; se pueden poner varios separados por comas. Si se omite, se permite cualquiera.
# FRONTEND_URL=http://localhost:3001
